[Unit]
Description=VayBooks Boutique Management System
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=__INSTALL_DIR__/app
Environment=VAYBOOKS_DATA_DIR=__DATA_DIR__
Environment=PYTHONPATH=__INSTALL_DIR__/app
ExecStart=__INSTALL_DIR__/python/python -m services.combined --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
StandardOutput=append:__DATA_DIR__/logs/service.log
StandardError=append:__DATA_DIR__/logs/service.log

[Install]
WantedBy=multi-user.target
