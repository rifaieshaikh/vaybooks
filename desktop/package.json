{
  "name": "vaybooks-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "VayBooks Electron desktop shell",
  "main": "electron/main.js",
  "author": "VayBooks",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.vaybooks.bms",
    "productName": "VayBooks",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "artifactName": "VayBooks.${ext}"
    },
    "extraMetadata": {
      "main": "electron/main.js"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
